# API process: values may be loaded with uvicorn --env-file .env
STORAGE_DIR=./storage
DATABASE_URL=sqlite:///./storage/expense.db
# Frontend server process (defaults to localhost backend)
API_BASE_URL=http://127.0.0.1:8000

# External receipt extraction (OpenAI Responses API). Disabled until explicitly enabled.
RECEIPT_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
# auto: weak OCR -> text; no OCR -> image (only with ALLOW_IMAGES=true)
# text: weak OCR text only; vision: scan each image directly without PaddleOCR
RECEIPT_LLM_MODE=vision
# Images contain payment/personal details; enable explicitly for vision/no-OCR fallback.
RECEIPT_LLM_ALLOW_IMAGES=false
# Optional model rates in USD / 1 million tokens; blank = cost not estimated.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
